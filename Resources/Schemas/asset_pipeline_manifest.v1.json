{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectokey.local/schemas/ai-asset-pipeline-manifest-v1.schema.json",
  "title": "AI Asset Pipeline Manifest",
  "type": "object",
  "required": ["$schema", "version", "outputs", "alpha_contract"],
  "properties": {
    "$schema": { "const": "ai-asset-pipeline-manifest-v1" },
    "version": { "type": "string", "minLength": 1 },
    "created": { "type": "string" },
    "policy": { "type": "string" },
    "spec_file": { "type": "string", "minLength": 1 },
    "source_art": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "texture_package_path": { "type": "string" },
    "ue_import": { "type": "object", "additionalProperties": true },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "runtime_file",
          "runtime_asset_name",
          "ue_package_path",
          "ue_asset_name",
          "target_size",
          "texture_type",
          "diagnostics"
        ],
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "runtime_file": { "type": "string", "minLength": 1 },
          "runtime_asset_name": { "type": "string", "minLength": 1 },
          "ue_package_path": { "type": "string", "pattern": "^/Game/" },
          "ue_asset_name": { "type": "string", "minLength": 1 },
          "ue_asset_path": { "type": "string" },
          "target_size": {
            "type": "array",
            "prefixItems": [
              { "type": "integer", "minimum": 1 },
              { "type": "integer", "minimum": 1 }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "texture_type": { "enum": ["color", "mask", "glow", "icon"] },
          "diagnostics": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "reviews": { "type": "object", "additionalProperties": true },
    "alpha_contract": {
      "type": "object",
      "required": [
        "all_transparent_corners",
        "all_transparent_outer_edges",
        "all_no_visible_chroma_key",
        "all_no_visible_magenta_fringe",
        "all_no_low_alpha_saturated_chroma_fringe",
        "all_no_hidden_saturated_chroma",
        "all_no_low_alpha_saturated_rgb_artifacts",
        "all_no_hidden_saturated_rgb_artifacts",
        "component_count"
      ],
      "properties": {
        "all_transparent_corners": { "const": true },
        "all_transparent_outer_edges": { "const": true },
        "all_no_visible_chroma_key": { "const": true },
        "all_no_visible_magenta_fringe": { "const": true },
        "all_no_low_alpha_saturated_chroma_fringe": { "const": true },
        "all_no_hidden_saturated_chroma": { "const": true },
        "all_no_low_alpha_saturated_rgb_artifacts": { "const": true },
        "all_no_hidden_saturated_rgb_artifacts": { "const": true },
        "component_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
