{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-texture-density-policy-v1",
  "title": "Measured standalone texture density policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "spec", "spec_sha256", "evidence", "required_scenarios", "expected_viewports", "texels_per_pixel", "max_texture_dimension", "max_rgba8_mip_bytes", "candidate_package"],
  "properties": {
    "$schema": {"const": "ai-texture-density-policy-v1"},
    "spec": {"type": "string", "minLength": 1},
    "spec_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "required_scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_viewports": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}},
    "texels_per_pixel": {"type": "number", "exclusiveMinimum": 0},
    "max_texture_dimension": {"type": "integer", "minimum": 1},
    "max_rgba8_mip_bytes": {"type": "integer", "minimum": 1},
    "allow_downsize": {"type": "boolean", "default": false},
    "candidate_package": {"type": "string", "pattern": "^/Game/(?:[A-Za-z0-9_]+/)*[A-Za-z0-9_]+$"},
    "notes": {"type": "string"}
  }
}
