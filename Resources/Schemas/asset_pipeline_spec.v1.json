{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectokey.local/schemas/ai-asset-pipeline-spec-v1.schema.json",
  "title": "AI Asset Pipeline Spec",
  "type": "object",
  "required": ["$schema", "run_id", "source_art", "runtime_output_dir", "review_output_dir", "components"],
  "properties": {
    "$schema": { "const": "ai-asset-pipeline-spec-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "created": { "type": "string" },
    "validation_policy": { "const": "fail_closed" },
    "runtime_output_dir": { "type": "string", "minLength": 1 },
    "review_output_dir": { "type": "string", "minLength": 1 },
    "manifest_name": { "type": "string" },
    "source_art": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "prompt_files", "provenance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "prompt_files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "provenance": {
            "type": "object",
            "required": ["provider", "model", "generation_id"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "generation_id": { "type": "string", "minLength": 1 },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "derived_components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "ue_import": {
      "type": "object",
      "properties": {
        "texture_package_path": { "type": "string", "pattern": "^/Game/" },
        "probe_wbp_path": { "type": "string", "pattern": "^/Game/" },
        "texture_import_policy": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["component_id", "draw_rect", "asset_suffix", "runtime_asset_name", "ue_asset_name"],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "source_art_id": { "type": "string" },
        "selector": { "type": "object", "additionalProperties": true },
        "draw_rect": {
          "type": "array",
          "prefixItems": [
            { "type": "integer" },
            { "type": "integer" },
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "asset_suffix": { "type": "string", "minLength": 1 },
        "runtime_asset_name": { "type": "string", "minLength": 1 },
        "ue_package_path": { "type": "string", "pattern": "^/Game/" },
        "ue_asset_name": { "type": "string", "minLength": 1 },
        "texture_type": { "enum": ["color", "mask", "glow", "icon"] },
        "processing_mode": {
          "enum": [
            "resize_premultiplied",
            "resize",
            "fit_aspect_premultiplied",
            "contain_premultiplied",
            "soft_glow_resize",
            "nine_slice_prerender",
            "approved_source_target_size",
            "vector_sdf_icon",
            "source_quality_clean",
            "passthrough",
            "copy_exact"
          ],
          "default": "resize_premultiplied"
        },
        "soft_glow_resize": {
          "type": "object",
          "properties": {
            "alpha_median_size": { "type": "integer", "minimum": 0 },
            "alpha_blur_radius": { "type": "number", "minimum": 0 },
            "alpha_low_cutoff": { "type": "number", "minimum": 0, "maximum": 1 },
            "alpha_high_cutoff": { "type": "number", "minimum": 0, "maximum": 1 },
            "alpha_gamma": { "type": "number", "exclusiveMinimum": 0 },
            "alpha_scale": { "type": "number", "minimum": 0 },
            "alpha_cap": { "type": "number", "minimum": 0, "maximum": 1 },
            "border_fade_px": { "type": "number", "minimum": 0 },
            "brightness_blur_radius": { "type": "number", "minimum": 0 },
            "palette": {
              "type": "object",
              "properties": {
                "outer": { "$ref": "#/$defs/rgbTriplet" },
                "body": { "$ref": "#/$defs/rgbTriplet" },
                "core": { "$ref": "#/$defs/rgbTriplet" },
                "body_edge": { "$ref": "#/$defs/floatPair" },
                "core_edge": { "$ref": "#/$defs/floatPair" },
                "core_mix": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "nine_slice": {
          "type": "object",
          "properties": {
            "source_margin": {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 }
              ],
              "minItems": 4,
              "maxItems": 4
            },
            "target_margin": {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 }
              ],
              "minItems": 4,
              "maxItems": 4
            }
          },
          "additionalProperties": true
        },
        "vector_icon": {
          "type": "object",
          "properties": {
            "glyph": {
              "enum": [
                "mic_unmuted",
                "microphone_unmuted",
                "mic_muted",
                "microphone_muted",
                "add_friend",
                "person_plus",
                "self_balance",
                "seat_balance"
              ]
            },
            "supersample": { "type": "integer", "minimum": 3 },
            "bevel_edge_px": { "type": "number", "minimum": 0 },
            "alpha_floor": { "type": "integer", "minimum": 0, "maximum": 255 },
            "transparent_rgb_dilation": { "type": "integer", "minimum": 0 },
            "clear_outer_alpha_px": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "alpha_contract_policy": {
          "type": "object",
          "properties": {
            "allow_low_alpha_saturated_rgb_artifacts": { "type": "boolean" },
            "allow_hidden_saturated_rgb_artifacts": { "type": "boolean" },
            "reason": { "type": "string" }
          },
          "additionalProperties": true
        },
        "target_size": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": true
    },
    "rgbTriplet": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 },
        { "type": "integer", "minimum": 0, "maximum": 255 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "floatPair": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": true
}
